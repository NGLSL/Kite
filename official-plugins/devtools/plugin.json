{
  "schema_version": 1,
  "plugin": {
    "id": "com.kite.devtools",
    "name": "开发者工具",
    "version": "0.1.0",
    "description": "uuid / hash / 时间戳 / json 等常用开发查询",
    "usage": "在搜索框输入关键词，触发对应开发工具。\n\n工具\n  uuid\n    生成一条 UUID，Enter 复制。\n\n  hash <文本>\n    计算哈希（如 hash abc）。\n\n  ts\n    时间戳相关查询。\n\n  json\n    独立面板：设置 → 插件 → 打开 JSON 面板。\n    左原始、右结果；格式化 / 压缩 / 剪贴板。\n    Esc 或 × 关闭面板。\n\n  json <JSON>\n    搜索框快速格式化（适合短内容）。\n    示例：json {\"name\":\"kite\",\"n\":1}\n\n通用\n  关键词需整词匹配。\n  命令入口：搜索「生成 UUID」。",
    "author": "Kite"
  },
  "compatibility": {
    "plugin_api": 1,
    "minimum_kite_version": "0.3.0"
  },
  "runtime": {
    "command": "kite-plugin-devtools.exe",
    "args": [],
    "startup_timeout_ms": 5000,
    "idle_timeout_ms": 60000
  },
  "contributes": {
    "examples": ["uuid", "hash abc", "ts", "json {\"a\":1}"],
    "commands": [
      {
        "id": "uuid",
        "title": "生成 UUID",
        "keywords": ["uuid"],
        "action": { "type": "enter_provider", "provider": "uuid" }
      }
    ],
    "providers": [
      {
        "id": "uuid",
        "response_mode": "panel",
        "triggers": [{ "type": "keyword", "value": "uuid" }]
      },
      {
        "id": "hash",
        "response_mode": "panel",
        "triggers": [{ "type": "keyword", "value": "hash" }]
      },
      {
        "id": "ts",
        "response_mode": "panel",
        "triggers": [{ "type": "keyword", "value": "ts" }]
      },
      {
        "id": "json",
        "response_mode": "panel",
        "triggers": [{ "type": "keyword", "value": "json" }]
      }
    ]
  }
}
