{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kite",
  "version": "0.2.0",
  "identifier": "com.kite.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kite",
        "width": 640,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "backgroundColor": "#ffffff",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "copyright": "Copyright 2026 Kite Authors · Apache-2.0",
    "resources": ["resources/*"],
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
